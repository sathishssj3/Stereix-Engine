/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://stereix-engine.pages.dev blob:; connect-src 'self' https://api.github.com https://cdn.jsdelivr.net https://stereix-engine.pages.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none';
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/admin
  Cache-Control: no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/admin.html
  Cache-Control: no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable
